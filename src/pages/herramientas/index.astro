---
import { ArrowRight } from "@lucide/astro";
import allTools from "@/data/tools.json";
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { breadcrumbs } from "@/lib/schema";
import { pageSeo } from "@/lib/seo";

const categories = ["Nutrición", "Mediciones", "Entrenamiento"] as const;
const toolsByCategory = categories.map((cat) => ({
	name: cat,
	tools: allTools.filter((t) => t.category === cat),
}));

const seo = pageSeo({
	title: "Herramientas de Nutrición",
	description:
		"Descubre mis herramientas de nutrición gratuitas diseñadas para ayudarte en tu viaje hacia una vida más saludable.",
	keywords: [
		"salud",
		"bienestar",
		"calculadora",
		"imc",
		"nutrición",
		"herramientas",
		"nutralech",
		"marialy alonso",
	],
	url: "https://www.nutralech.com/herramientas",
});
---
<Layout seo={seo}>
	<JsonLd slot="head" schema={breadcrumbs(["Herramientas", "/herramientas"])} />
		<section class="py-28 bg-[oklch(99%_0.005_12)]">
			<div class="mx-auto max-w-4xl px-4 sm:px-6">
				{/* Header */}
				<div class="mb-16">
					<p class="text-sm font-medium tracking-wide uppercase text-[#B5404F] mb-3">
						Herramientas gratuitas
					</p>
					<h1 class="font-serif text-3xl font-medium tracking-tight text-[oklch(18%_0.005_12)] sm:text-4xl lg:text-5xl">
						Calculadoras de nutrición
					</h1>
									<p class="mt-4 text-base leading-relaxed text-[oklch(50%_0.01_12)] max-w-xl">
						Estimaciones rápidas para calorías, macros, hidratación y más.
						Para un plan personalizado, conoce el Plan a distancia.
					</p>
				</div>

				{/* Grouped tools */}
				<div class="space-y-12">
					{toolsByCategory.map((group) => (
						<div>
							<h2 class="text-xs font-medium tracking-wide uppercase text-[oklch(48%_0.005_12)] mb-4">
								{group.name}
							</h2>
							<div class="divide-y divide-[oklch(94%_0.005_12)] rounded-xl border border-[oklch(92%_0.005_12)] bg-white">
								{group.tools.map((tool) => (
									<a
										href={tool.link}
										class="group flex items-center justify-between gap-4 px-5 py-4 transition-colors duration-150 first:rounded-t-xl last:rounded-b-xl hover:bg-[oklch(98%_0.01_12)]"
									>
										<div class="min-w-0">
											<h3 class="text-sm font-medium text-[oklch(18%_0.005_12)] group-hover:text-[#B5404F] transition-colors duration-150">
												{tool.title}
											</h3>
											<p class="mt-0.5 text-sm text-[oklch(48%_0.01_12)] truncate">
												{tool.description}
											</p>
										</div>
										<ArrowRight class="h-4 w-4 shrink-0 text-[oklch(78%_0.005_12)] transition-all duration-150 group-hover:text-[#B5404F] group-hover:translate-x-0.5" />
									</a>
								))}
							</div>
						</div>
					))}
				</div>

				{/* CTA */}
				<div class="mt-16 rounded-2xl bg-[oklch(96.5%_0.01_12)] p-8 sm:p-10">
					<h2 class="font-serif text-xl font-medium text-[oklch(18%_0.005_12)]">
						Necesitas un plan personalizado?
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-[oklch(50%_0.01_12)] max-w-lg">
						Las calculadoras dan estimaciones generales. Para un plan
						adaptado a tu cuerpo, objetivos y rutina, el Plan a distancia es el
						siguiente paso.
					</p>
					<a
						href="/#precios"
						class="mt-6 inline-flex h-11 items-center rounded-full bg-[#C54B5B] px-7 text-sm font-medium text-white transition-colors duration-200 hover:bg-[#C54B5B]"
					>
						Ver plan a distancia
					</a>
				</div>
			</div>
		</section>
</Layout>
