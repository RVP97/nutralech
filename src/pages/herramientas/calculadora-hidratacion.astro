---
import { Activity, Apple, Book, Calendar, Info } from "@lucide/astro";
import HydrationCalculator from "@/components/tools/HydrationCalculator.astro";
import { buttonClass } from "@/components/ui/button";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import Layout from "@/layouts/Layout.astro";
import { pageSeo } from "@/lib/seo";

const seo = pageSeo({
	title: "Calculadora de Hidratación Diaria",
	description:
		"Calcula tus necesidades diarias de hidratación y mantente saludable con la herramienta de Nutralech.",
	keywords: ["hidratación, salud, bienestar, agua, consumo, consejos, nutrición, nutralech, marialy alonso, nutriologa"],
	url: "https://www.nutralech.com/herramientas/calculadora-hidratacion",
});
---
<Layout seo={seo}>
<div class="max-w-7xl mx-auto px-4 py-20">
	<nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
		<a href="/">Inicio</a>
		<span>{">"}</span>
		<a href="/herramientas">Herramientas</a>
		<span>{">"}</span>
		<span class="text-foreground">Calculadora de Hidratación</span>
	</nav>

	<div class="text-center mb-12">
		<div class="text-sm font-medium text-primary mb-2">
			HERRAMIENTAS
		</div>
		<h1 class="text-4xl font-bold tracking-tight mb-4">
			Calculadora de Hidratación
		</h1>
		<p class="text-xl text-muted-foreground max-w-[800px] mx-auto">
			Calcula tus necesidades diarias de hidratación de manera fácil y
			rápida. Obtén una estimación precisa basada en tu perfil personal y
			nivel de actividad.
		</p>
	</div>

	<div class="grid lg:grid-cols-2 gap-6">
		<HydrationCalculator />

		<div class="space-y-6">
			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Info class="h-5 w-5" />
						Importancia de la Hidratación
					</CardTitle>
				</CardHeader>
				<CardContent>
					<p class="mb-3">
						Mantenerse hidratado es esencial para el funcionamiento óptimo
						del cuerpo. Aquí hay algunos consejos para asegurar una
						hidratación adecuada:
					</p>
					<ul class="list-disc pl-5 space-y-2">
						<li>
							<strong>Consumo Diario:</strong> Se recomienda beber al menos
							8 vasos de agua al día.
						</li>
						<li>
							<strong>Factores Influyentes:</strong> La actividad física, el
							clima y la salud general pueden afectar tus necesidades de
							agua.
						</li>
						<li>
							<strong>Señales de Deshidratación:</strong> Sed, orina oscura,
							fatiga y mareos son signos comunes.
						</li>
					</ul>
				</CardContent>
			</Card>

			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Activity class="h-5 w-5" />
						Consejos para Mantenerse Hidratado
					</CardTitle>
				</CardHeader>
				<CardContent>
					<ul class="list-disc pl-5 space-y-1">
						<li>Bebe agua regularmente a lo largo del día.</li>
						<li>Incluye alimentos ricos en agua como frutas y verduras.</li>
						<li>Evita bebidas azucaradas y con cafeína en exceso.</li>
						<li>Escucha a tu cuerpo y bebe cuando tengas sed.</li>
						<li>
							Ajusta tu consumo de agua según tu nivel de actividad y clima.
						</li>
					</ul>
				</CardContent>
			</Card>

			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Book class="h-5 w-5" />
						Recursos Adicionales
					</CardTitle>
				</CardHeader>
				<CardContent>
					<ul class="space-y-2">
						<li>
							<a
								href="/herramientas/calculadora-calorias"
								class="text-blue-700 underline hover:no-underline"
							>
								Calculadora de Calorías
							</a>
						</li>
						<li>
							<a
								href="/herramientas/calculadora-imc"
								class="text-blue-700 underline hover:no-underline"
							>
								Calculadora de IMC
							</a>
						</li>
						<li>
							<a
								href="/#precios"
								class="text-blue-700 underline hover:no-underline"
							>
								Planes y Consultas
							</a>
						</li>
						<li>
							<a
								href="#"
								class="text-blue-700 underline hover:no-underline"
							>
								Consulta con Nutricionistas
							</a>
						</li>
					</ul>
				</CardContent>
			</Card>
		</div>
	</div>

	<Card class="mt-6">
		<CardHeader>
			<CardTitle as="h2" class="flex items-center gap-2">
				<Apple class="h-5 w-5" />
				Hidratación y Salud
			</CardTitle>
		</CardHeader>
		<CardContent>
			<p>
				Una hidratación adecuada es clave para una buena salud,
				independientemente de tu nivel de actividad:
			</p>
			<ul class="list-disc pl-5 space-y-1">
				<li>Incluye agua en cada comida y entre comidas.</li>
				<li>Opta por agua en lugar de bebidas azucaradas.</li>
				<li>Incorpora alimentos ricos en agua en tu dieta.</li>
				<li>Limita el consumo de alcohol y cafeína.</li>
				<li>Mantente hidratado bebiendo suficiente agua durante el día.</li>
			</ul>
		</CardContent>
	</Card>

	<div class="mt-8 text-center max-w-2xl mx-auto">
		<p class="text-muted-foreground mb-4">
			Recuerda que esta calculadora proporciona una estimación. Para un plan
			de hidratación personalizado que se ajuste a tus necesidades,{" "}
			<a
				href="/#precios"
				class="text-blue-700 underline hover:no-underline"
			>
				conoce el Plan a distancia
			</a>{" "}
			conmigo.
		</p>
	</div>

	<div class="mt-12 bg-linear-to-r from-[#C54B5B] to-[#B03F4F] rounded-lg shadow-lg">
		<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:py-16 lg:px-8 lg:flex lg:items-center lg:justify-between">
			<h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
				<span class="block">¿Listo para mejorar tu salud?</span>
				<span class="block text-gray-100">
					Empieza tu plan a distancia hoy.
				</span>
			</h2>
			<div class="mt-8 flex lg:mt-0 lg:shrink-0">
				<div class="inline-flex rounded-md shadow-sm">
					<a href="/#precios" class={buttonClass({ variant: "plain", class: "inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-[#B5404F] bg-white hover:bg-gray-50" })}>
							<Calendar class="w-5 h-5 mr-2" />
							Ver plan a distancia
						</a>
				</div>
			</div>
		</div>
	</div>
</div>
</Layout>
