---
import { Activity, Apple, Book, Calendar, Info } from "@lucide/astro";
import MacroCalculatorForm from "@/components/tools/MacroCalculatorForm.astro";
import { buttonClass } from "@/components/ui/button";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import Layout from "@/layouts/Layout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { toolSchema } from "@/lib/schema";
import { pageSeo } from "@/lib/seo";

const seo = pageSeo({
	title: "Calculadora de Macronutrientes",
	description:
		"Calcula tu distribución óptima de macronutrientes para tu dieta. Herramienta desarrollada por Nutralech.",
	keywords: ["salud, bienestar, calculadora, imc, nutrición, consejos, recetas, asesoría, personalizada, nutralech, marialy alonso, nutriologa"],
	url: "https://www.nutralech.com/herramientas/calculadora-macronutrientes",
});
---
<Layout seo={seo}>
	{toolSchema("/herramientas/calculadora-macronutrientes").map((schema) => <JsonLd slot="head" schema={schema} />)}
<div class="max-w-7xl mx-auto px-4 py-20">
	<nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
		<a href="/">
			Inicio
		</a>
		<span>{">"}</span>
		<a href="/herramientas">
			Herramientas
		</a>
		<span>{">"}</span>
		<span class="text-foreground">Calculadora de IMC</span>
	</nav>

	<div class="text-center mb-12">
		<div class="text-sm font-medium text-primary mb-2">
			HERRAMIENTAS
		</div>
		<h1 class="text-4xl font-bold tracking-tight mb-4">
			Calculadora de Macronutrientes
		</h1>
		<p class="text-xl text-muted-foreground max-w-[800px] mx-auto">
			Optimiza tu nutrición calculando la distribución ideal de
			macronutrientes según tus objetivos específicos. Obtén una guía
			personalizada de proteínas, carbohidratos y grasas para alcanzar tus
			metas de forma saludable.
		</p>
	</div>

	<div class="grid lg:grid-cols-2 gap-6">
		<MacroCalculatorForm />

		<div class="space-y-6">
			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Info class="h-5 w-5" />
						Guía Completa de Macronutrientes
					</CardTitle>
				</CardHeader>
				<CardContent>
					<p class="mb-4">
						Los macronutrientes son nutrientes esenciales que tu cuerpo
						necesita en grandes cantidades para funcionar correctamente:
					</p>
					<div class="space-y-4">
						<div>
							<h3 class="font-semibold mb-2">Proteínas (4 kcal/g)</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Fundamentales para la construcción y reparación muscular
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Esenciales para el sistema inmunológico
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Ayudan en la producción de enzimas y hormonas
									</span>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="font-semibold mb-2">
								Carbohidratos (4 kcal/g)
							</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Principal fuente de energía para el cuerpo
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Fundamentales para el funcionamiento cerebral
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Preservan la masa muscular durante el ejercicio
									</span>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="font-semibold mb-2">Grasas (9 kcal/g)</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Vitales para la absorción de vitaminas liposolubles (A,
										D, E, K)
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Esenciales para la producción hormonal
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Proporcionan energía de larga duración
									</span>
								</li>
							</ul>
						</div>
					</div>
				</CardContent>
			</Card>

			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Activity class="h-5 w-5" />
						Factores que Afectan tus Macros
					</CardTitle>
				</CardHeader>
				<CardContent>
					<div class="space-y-4">
						<div>
							<h3 class="font-semibold mb-2">Nivel de Actividad</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Sedentario: Requiere menos carbohidratos, enfoque en
										proteínas
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Moderadamente activo: Balance equilibrado de macros
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Muy activo: Mayor necesidad de carbohidratos y proteínas
									</span>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="font-semibold mb-2">Composición Corporal</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Mayor masa muscular requiere más proteína para
										mantenimiento
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										El porcentaje de grasa corporal influye en la
										sensibilidad a carbohidratos
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										La edad afecta el metabolismo y necesidades
										nutricionales
									</span>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="font-semibold mb-2">
								Horario y Estilo de Vida
							</h3>
							<ul class="list-disc ml-4 space-y-1">
								<li class="pl-2">
									<span class="relative -left-2">
										Timing de comidas afecta la utilización de nutrientes
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Estrés y sueño impactan el metabolismo hormonal
									</span>
								</li>
								<li class="pl-2">
									<span class="relative -left-2">
										Preferencias alimentarias influyen en la adherencia
									</span>
								</li>
							</ul>
						</div>
					</div>
				</CardContent>
			</Card>

			<Card>
				<CardHeader>
					<CardTitle as="h2" class="flex items-center gap-2">
						<Book class="h-5 w-5" />
						Recursos y Consejos
					</CardTitle>
				</CardHeader>
				<CardContent>
					<ul class="space-y-2">
						<li>
							<a
								href="/herramientas/calculadora-calorias"
								class="text-blue-700 underline hover:no-underline"
							>
								Calculadora de Calorías
							</a>
						</li>
						<li>
							<a
								href="/herramientas/calculadora-hidratacion"
								class="text-blue-700 underline hover:no-underline"
							>
								Calculadora de Hidratación
							</a>
						</li>
						<li>
							<a
								href="/herramientas/calculadora-imc"
								class="text-blue-700 underline hover:no-underline"
							>
								Calculadora de IMC
							</a>
						</li>
					</ul>
				</CardContent>
			</Card>
		</div>
	</div>

	<Card class="mt-6">
		<CardHeader>
			<CardTitle as="h2" class="flex items-center gap-2">
				<Apple class="h-5 w-5" />
				Fuentes Óptimas de Macronutrientes
			</CardTitle>
		</CardHeader>
		<CardContent>
			<p>
				Una dieta equilibrada es clave para mantener un peso saludable.
				Considera estos consejos:
			</p>
			<ul class="list-disc ml-4 mt-2 space-y-1">
				<li class="pl-2">
					<span class="relative -left-2">
						Incluye una variedad de colores en tus comidas para asegurar
						diversos nutrientes.
					</span>
				</li>
				<li class="pl-2">
					<span class="relative -left-2">
						Opta por granos integrales en lugar de refinados.
					</span>
				</li>
				<li class="pl-2">
					<span class="relative -left-2">
						Incorpora proteínas magras y fuentes vegetales de proteína.
					</span>
				</li>
				<li class="pl-2">
					<span class="relative -left-2">
						Limita el consumo de alimentos procesados y azúcares añadidos.
					</span>
				</li>
				<li class="pl-2">
					<span class="relative -left-2">
						Practica la alimentación consciente, prestando atención a las
						señales de hambre y saciedad.
					</span>
				</li>
			</ul>
		</CardContent>
	</Card>

	<div class="mt-8 text-center max-w-2xl mx-auto">
		<p class="text-muted-foreground mb-4">
			Recuerda que el IMC es solo una guía general. Para una evaluación más
			precisa de tu salud y un plan personalizado,{" "}
			<a
				href="/#precios"
				class="text-blue-700 underline hover:no-underline"
			>
				conoce el Plan a distancia
			</a>{" "}
			conmigo.
		</p>
	</div>

	<div class="mt-12 bg-linear-to-r from-[#C54B5B] to-[#B03F4F] rounded-lg shadow-lg">
		<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:py-16 lg:px-8 lg:flex lg:items-center lg:justify-between">
			<h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
				<span class="block">¿Listo para mejorar tu salud?</span>
				<span class="block text-gray-100">
					Empieza tu plan a distancia hoy.
				</span>
			</h2>
			<div class="mt-8 flex lg:mt-0 lg:shrink-0">
				<div class="inline-flex rounded-md shadow-sm">
					<a href="/#precios" class={buttonClass({ variant: "plain", class: "inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-[#B5404F] bg-white hover:bg-gray-50" })}>
							<Calendar class="w-5 h-5 mr-2" />
							Ver plan a distancia
						</a>
				</div>
			</div>
		</div>
	</div>
</div>
</Layout>
