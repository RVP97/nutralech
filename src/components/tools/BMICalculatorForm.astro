---
import { Scale } from "@lucide/astro";
import Card from "@/components/ui/Card.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import { calcButtonClass, inputClass, labelClass } from "./form";
import Select from "./Select.astro";
---
<Card class="w-full h-full flex flex-col">
	<CardHeader>
		<CardTitle as="h2" class="text-2xl">Calcula tu IMC</CardTitle>
		<CardDescription>Ingresa tus datos para calcular tu Índice de Masa Corporal</CardDescription>
	</CardHeader>
	<CardContent class="grow space-y-6">
		<form data-calc="imc" novalidate class="space-y-4">
			<div class="space-y-2">
				<label for="unit" class={labelClass}>Sistema de Medida</label>
				<Select
					id="unit"
					name="unit"
					value="metric"
					options={[
						{ value: "metric", label: "Métrico (kg/cm)" },
						{ value: "imperial", label: "Imperial (lb/pies)" },
					]}
				/>
			</div>

			<div class="grid grid-cols-2 gap-4">
				<div class="space-y-2" data-when="unit:metric">
					<label for="height-cm" class={labelClass}>Altura (cm)</label>
					<input id="height-cm" name="cm" type="number" inputmode="decimal" placeholder="170" class={inputClass} />
				</div>
				<div class="space-y-2" data-when="unit:imperial" hidden>
					<label for="height-feet" class={labelClass}>Altura (pies)</label>
					<input id="height-feet" name="feet" type="number" inputmode="decimal" placeholder="5" class={inputClass} />
				</div>
				<div class="space-y-2" data-when="unit:imperial" hidden>
					<label for="height-inches" class={labelClass}>Altura (pulgadas)</label>
					<input id="height-inches" name="inches" type="number" inputmode="decimal" placeholder="7" class={inputClass} />
				</div>
				<div class="space-y-2">
					<label for="weight" class={labelClass}>
						Peso (<span data-text-when='{"field":"unit","metric":"kg","imperial":"lb"}'>kg</span>)
					</label>
					<input
						id="weight"
						name="weight"
						type="number"
						inputmode="decimal"
						placeholder="70"
						data-placeholder-when='{"field":"unit","metric":"70","imperial":"154"}'
						class={inputClass}
					/>
				</div>
			</div>

			<p data-part="error" role="alert" hidden class="text-red-600 text-sm"></p>
			<button type="submit" class:list={[calcButtonClass, "mt-4"]}>Calcular IMC</button>
		</form>

		<div data-part="result" hidden class="space-y-4" aria-live="polite">
			<div class="rounded-lg border p-4 space-y-2">
				<div class="flex items-center gap-2">
					<Scale class="h-5 w-5 text-muted-foreground" />
					<span class="font-medium">Tu IMC Calculado</span>
				</div>
				<div class="text-2xl font-bold" data-out="bmi"></div>
				<div class="font-medium" data-part="category"></div>
			</div>
			<div class="rounded-lg bg-gray-50 p-4 space-y-2">
				<div class="font-medium">Recomendación de Salud</div>
				<p class="text-sm text-muted-foreground" data-out="suggestion"></p>
			</div>
		</div>

		<div class="mt-6">
			<h3 class="text-lg font-semibold mb-2">Tabla de IMC</h3>
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-gray-100">
							<th class="p-2 text-left">IMC</th>
							<th class="p-2 text-left">Categoría</th>
						</tr>
					</thead>
					<tbody>
						<tr><td class="p-2 border-b">Menos de 18.5</td><td class="p-2 border-b text-blue-600">Bajo peso</td></tr>
						<tr><td class="p-2 border-b">18.5 - 24.9</td><td class="p-2 border-b text-green-700">Peso normal</td></tr>
						<tr><td class="p-2 border-b">25.0 - 29.9</td><td class="p-2 border-b text-yellow-700">Sobrepeso</td></tr>
						<tr><td class="p-2">30.0 o más</td><td class="p-2 text-red-600">Obesidad</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</CardContent>
</Card>

<script>
	import { error, num, out, part, register, str } from "@/scripts/tools/calc";

	const category = (bmi: number) => {
		if (bmi < 18.5) return { category: "Bajo peso", color: "text-blue-600" };
		if (bmi < 25) return { category: "Peso normal", color: "text-green-700" };
		if (bmi < 30) return { category: "Sobrepeso", color: "text-yellow-700" };
		return { category: "Obesidad", color: "text-red-600" };
	};
	const suggestion = (bmi: number) => {
		if (bmi < 18.5)
			return "Considera aumentar tu ingesta calórica y consultar con un profesional de la salud para un plan personalizado.";
		if (bmi < 25) return "¡Excelente! Mantén tus hábitos saludables de alimentación y ejercicio.";
		if (bmi < 30)
			return "Considera ajustar tu dieta y aumentar tu actividad física. Una reducción gradual de peso puede ser beneficiosa.";
		return "Es recomendable consultar con un profesional de la salud para desarrollar un plan de pérdida de peso seguro y efectivo.";
	};

	register("imc", (form) => {
		const card = form.parentElement as HTMLElement;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const metric = str(form, "unit") === "metric";
			const weight = num(form, "weight");
			if ((metric && (!num(form, "cm") || !weight)) || (!metric && (!num(form, "feet") || !weight))) {
				error(form, "Por favor, ingresa tanto la altura como el peso.");
				return;
			}
			error(form, "");
			let bmi: number;
			if (metric) {
				const meters = num(form, "cm") / 100;
				bmi = weight / (meters * meters);
			} else {
				const inches = num(form, "feet") * 12 + (num(form, "inches") || 0);
				bmi = (weight * 703) / (inches * inches);
			}
			bmi = Math.round(bmi * 10) / 10;
			const result = part(card, "result");
			result.hidden = !bmi;
			out(result, "bmi", bmi);
			const { category: name, color } = category(bmi);
			const el = part(result, "category");
			el.textContent = name;
			el.className = `font-medium ${color}`;
			out(result, "suggestion", suggestion(bmi));
		});
	});
</script>
