---
import { Moon, Sun } from "@lucide/astro";

const locations = [
	{ city: "CDMX", country: "México", flag: "🇲🇽", offset: -6 },
	{ city: "Nueva York", country: "Estados Unidos", flag: "🇺🇸", offset: -5 },
	{ city: "Bogotá", country: "Colombia", flag: "🇨🇴", offset: -5 },
	{ city: "Buenos Aires", country: "Argentina", flag: "🇦🇷", offset: -3 },
	{ city: "Londres", country: "Reino Unido", flag: "🇬🇧", offset: 0 },
	{ city: "Tokio", country: "Japón", flag: "🇯🇵", offset: 9 },
];
const first = locations[0];
---
<section class="py-24 bg-white overflow-hidden" data-world-clock>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-16 lg:grid-cols-[1fr_1.2fr] lg:items-center">
			<div>
				<p class="text-sm font-medium tracking-wide uppercase text-[#B5404F]">6 continentes</p>
				<h2 class="mt-3 font-serif text-3xl font-medium tracking-tight text-[oklch(18%_0.005_12)] sm:text-4xl lg:text-5xl">
					Desde cualquier país, a tu ritmo
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-[oklch(45%_0.01_12)] max-w-md">
					Atiendo pacientes en 6 continentes con el Plan a distancia: sin agendar cita ni cuadrar horarios. Tú envías tu información y recibes un plan adaptado a tu vida, con soporte por WhatsApp.
				</p>

				<a
					href="#precios"
					class="mt-8 inline-flex h-12 items-center justify-center rounded-full bg-[#C54B5B] px-8 text-sm font-medium text-white transition-colors duration-200 hover:bg-[#C54B5B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#DA5F6F]"
				>
					Ver plan a distancia
				</a>
			</div>

			<div class="space-y-3">
				<div data-clock-card class="rounded-2xl bg-[oklch(97%_0.01_12)] p-8 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)]">
					<div class="flex items-start justify-between">
						<div>
							<span class="text-3xl" data-clock-flag>{first.flag}</span>
							<h3 class="mt-3 text-2xl font-medium text-[oklch(18%_0.005_12)]" data-clock-city>{first.city}</h3>
							<p class="mt-1 text-sm text-[oklch(50%_0.01_12)]" data-clock-country>{first.country}</p>
						</div>
						<div class="text-right">
							<span class="block min-h-9 text-3xl font-medium tabular-nums text-[oklch(18%_0.005_12)]" data-clock-time></span>
							<span class="mt-1 inline-flex items-center gap-1.5 text-xs text-[oklch(48%_0.01_12)]">
								<span data-clock-day class="inline-flex items-center gap-1.5">
									<Sun class="h-3.5 w-3.5 text-[oklch(75%_0.15_85)]" />
									Plan a tu ritmo
								</span>
								<span data-clock-night hidden class="inline-flex items-center gap-1.5">
									<Moon class="h-3.5 w-3.5 text-[oklch(55%_0.1_260)]" />
									Sin agendar cita
								</span>
							</span>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
					{
						locations.map((loc, i) => (
							<button
								type="button"
								data-clock-index={i}
								data-offset={loc.offset}
								data-city={loc.city}
								data-country={loc.country}
								data-flag={loc.flag}
								aria-pressed={i === 0 ? "true" : "false"}
								class="group flex items-center justify-between rounded-xl px-4 py-3.5 text-left transition-colors duration-200 bg-[oklch(97%_0.005_12)] text-[oklch(35%_0.005_12)] hover:bg-[oklch(94%_0.01_12)] aria-pressed:bg-[#C54B5B] aria-pressed:text-white"
							>
								<span class="flex items-center gap-2 text-sm">
									<span>{loc.flag}</span>
									<span class="font-medium">{loc.city}</span>
								</span>
								<span class="text-xs tabular-nums text-[oklch(48%_0.005_12)] group-aria-pressed:text-white" data-clock-small></span>
							</button>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// The local time in each city, and the featured city rotating every 4 seconds.
	let timer: ReturnType<typeof setInterval> | undefined;

	const localTime = (offset: number, now: Date) => {
		const utc = now.getTime() + now.getTimezoneOffset() * 60000;
		return new Date(utc + offset * 3600000);
	};
	const format = (d: Date) => d.toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });

	function setup() {
		clearInterval(timer);
		const root = document.querySelector<HTMLElement>("[data-world-clock]");
		if (!root) return;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-clock-index]")];
		const card = root.querySelector<HTMLElement>("[data-clock-card]");
		const field = (name: string) => root.querySelector<HTMLElement>(`[data-clock-${name}]`);
		let active = 0;

		const render = (animate: boolean) => {
			const now = new Date();
			buttons.forEach((b, i) => {
				b.setAttribute("aria-pressed", String(i === active));
				const small = b.querySelector("[data-clock-small]");
				if (small) small.textContent = format(localTime(Number(b.dataset.offset), now));
			});
			const b = buttons[active];
			const update = () => {
				const t = localTime(Number(b.dataset.offset), now);
				const flag = field("flag");
				const city = field("city");
				const country = field("country");
				const time = field("time");
				if (flag) flag.textContent = b.dataset.flag ?? "";
				if (city) city.textContent = b.dataset.city ?? "";
				if (country) country.textContent = b.dataset.country ?? "";
				if (time) time.textContent = format(t);
				const day = t.getHours() >= 6 && t.getHours() < 18;
				const dayEl = field("day");
				const nightEl = field("night");
				if (dayEl) dayEl.hidden = !day;
				if (nightEl) nightEl.hidden = day;
			};
			if (!animate || !card || matchMedia("(prefers-reduced-motion: reduce)").matches) {
				update();
				return;
			}
			card.style.opacity = "0";
			card.style.transform = "translateY(-8px)";
			setTimeout(() => {
				update();
				card.style.transition = "none";
				card.style.transform = "translateY(8px)";
				void card.offsetWidth;
				card.style.transition = "";
				card.style.opacity = "1";
				card.style.transform = "translateY(0)";
			}, 300);
		};

		const restart = () => {
			clearInterval(timer);
			timer = setInterval(() => {
				active = (active + 1) % buttons.length;
				render(true);
			}, 4000);
		};
		buttons.forEach((b, i) =>
			b.addEventListener("click", () => {
				active = i;
				render(true);
				restart();
			})
		);
		render(false);
		restart();
	}

	document.addEventListener("astro:page-load", setup);
	document.addEventListener("astro:before-swap", () => clearInterval(timer));
</script>
