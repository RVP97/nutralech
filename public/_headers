# Cloudflare static asset headers (see wrangler.jsonc).

# Pages may be reused for a minute without asking again, so a page that was prefetched when its
# link scrolled into view opens without another round trip. Short enough that a deploy shows up
# almost right away; the hashed files below are cached for a year instead.
/*
  Cache-Control: public, max-age=60
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_img/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Markdown versions of the pages (integrations/markdown-pages.mjs).
/*.md
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

# The preview host stays out of search results.
https://astro.nutralech.com/*
  X-Robots-Tag: noindex
