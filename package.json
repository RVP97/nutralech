{
	"name": "nutralech",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "portless run astro dev",
		"dev:3000": "astro dev --port 3000",
		"build": "astro build && node scripts/generate-image-variants.mjs",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"type-check": "astro check"
	},
	"dependencies": {
		"@astrojs/mdx": "8.1.2",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/astro": "0.564.0",
		"@stripe/stripe-js": "^4.9.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.4",
		"canvas-confetti": "^1.9.4",
		"gray-matter": "^4.0.3",
		"lucide": "0.564.0",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.4.5",
		"@cloudflare/workers-types": "^5.20261031.1",
		"@tailwindcss/typography": "^0.5.19",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^25.2.3",
		"linkedom": "^0.18.15",
		"tailwindcss": "^4.1.18",
		"turndown": "^7.2.4",
		"typescript": "^5",
		"wrangler": "4.156.0"
	}
}
